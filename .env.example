# Supabase pooled connection (PgBouncer, transaction mode, port 6543). Used by the app's
# runtime query client (src/db/client.ts).
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string > "Transaction" pooler.
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Required for migrations and the seed script: PgBouncer's transaction-mode pooling (the
# DATABASE_URL above) does not reliably support prepared statements. Use the session pooler,
# not Supabase's "Direct connection" string: that host (db.[project-ref].supabase.co) resolves
# IPv6-only, which times out on networks without IPv6 routing. The session pooler is the same
# host as DATABASE_URL, just port 5432 instead of 6543, and resolves IPv4.
# Get this from: same page as DATABASE_URL > "Session" pooler.
DIRECT_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase project URL and anon (public) key, used by the browser client, the server client,
# and the session-refresh middleware. Get both from: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"

# Not used anywhere in this app: nothing server-side needs to bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications, e.g. "you got a new inquiry"). Get the API key from
# resend.com > API Keys. RESEND_FROM_EMAIL must be an address on a domain verified in Resend;
# until you verify one, Resend's shared "onboarding@resend.dev" only delivers to the email
# address on your own Resend account, not to real users.
RESEND_API_KEY="[resend-api-key]"
RESEND_FROM_EMAIL="ScrimmApp <onboarding@resend.dev>"

# Absolute base URL used to build links inside emails (e.g. "View in your inbox"). Update this
# to the real deployed URL once ScrimmApp is live somewhere other than localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
