# Supabase pooled connection (PgBouncer, transaction mode, port 6543). Used by the app's
# runtime query client (src/db/client.ts).
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string > "Transaction" pooler.
DATABASE_URL="postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase direct (non-pooled) connection, port 5432. Required for migrations and the seed
# script: PgBouncer's transaction-mode pooling does not reliably support prepared statements.
# Get this from: same page > "Direct connection".
DIRECT_URL="postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase project URL and anon (public) key, used by the browser client, the server client,
# and the session-refresh middleware. Get both from: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-public-key]"

# Not used anywhere in this app: nothing server-side needs to bypass RLS.
# SUPABASE_SERVICE_ROLE_KEY=
